[Remote Filter]
All = NameRegex, FilterKey = "."
HK = NameRegex, FilterKey = "(?i)🇭🇰|香港|(\b(HK|HKT|Hong)\b)"
US = NameRegex, FilterKey = "(?i)🇺🇸|美国|洛杉矶|圣何塞|(\b(US|LA|United States)\b)"
SG = NameRegex, FilterKey = "(?i)🇸🇬|新加坡|狮|(\b(SG|Singapore)\b)"
UK = NameRegex, FilterKey = "(?i)🇬🇧|英国|(\b(UK|London)\b)"
JP = NameRegex, FilterKey = "(?i)🇯🇵|日本|东京|(\b(JP|Japan)\b)"
TW = NameRegex, FilterKey = "(?i)🇨🇳|🇹🇼|台湾|(\b(TW|Tai|Taiwan)\b)"
其他 = NameRegex, FilterKey = "(?i)🇲🇾|🇳🇬|🇦🇷|🇮🇱|🇰🇵|🇦🇶|🇻🇦|🇨🇺|🇪🇬|🇬🇷|🇬🇱|🇵🇦|🇲🇽|🇹🇷|🇲🇴|🇫🇷|🇵🇭|🇳🇿|🇨🇭|马来|尼日利亚|阿根廷|以色列|北朝鲜|南极|梵蒂冈|古巴|埃及|希腊|格陵兰|巴拿马|墨西哥|土耳其|澳门|法国|菲律宾|新西兰|瑞士|(\b(MYS|NGA|ARG|ISR|DPK|ATA|VAT|CUB|EGP|GRC|GRL|PAN|MEX|TUR|MAC|FRA|PHL|NZL|CHE)\b)"

